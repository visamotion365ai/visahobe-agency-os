{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -w @visahobe/shared && npm run build -w @visahobe/web && node scripts/build-vercel.mjs",
  "installCommand": "npm install --omit=optional --no-audit --no-fund",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/health", "destination": "/api/index.mjs" },
    { "source": "/ready", "destination": "/api/index.mjs" },
    { "source": "/((?!api/|health|ready|assets/|icons/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
