# ------------------------------------------------------------------
# VisaHOBe Agency OS — environment template
# Copy to .env and fill in. Never commit real secrets.
# ------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Database. Leave DATABASE_URL empty to use the bundled SQLite file.
# For PostgreSQL: DATABASE_URL=postgres://visahobe:password@127.0.0.1:5432/visahobe
DATABASE_URL=
DB_FILE=./data/visahobe.db

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_HOURS=336

# Private document storage (never served statically)
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25

# Shared secret between the API server and the self-hosted browser worker
WORKER_TOKEN=
WORKER_URL=ws://127.0.0.1:8787/api/browser/worker
WORKER_LABEL=local-worker
BROWSER_ALLOW_DOMAINS=
BROWSER_BLOCK_DOMAINS=
BROWSER_TIMEOUT_MS=120000
BROWSER_MAX_CONCURRENCY=2

# Local AI (optional). Ollama is auto-detected; no key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Self-hosted Firecrawl (optional)
FIRECRAWL_URL=
FIRECRAWL_API_KEY=

# Google Workspace (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/integrations/google/callback

# Agency policy defaults
PASSPORT_VALIDITY_MONTHS=6

# First-run administrator
BOOTSTRAP_ADMIN_EMAIL=admin@visahobe.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=VisaHOBe Admin

# Comma separated list of allowed browser origins
ALLOWED_ORIGINS=
TRUST_PROXY=false
